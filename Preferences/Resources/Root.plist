			<string>PSGroupCell</string>
			<key>label</key>
			<string>常用 App</string>
			<key>footerText</key>
			<string>在分屏上方容器显示自选 App。从下往上排列，最下面为第一位；下方容器不重复显示已选 App。未选择时不占空间。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
