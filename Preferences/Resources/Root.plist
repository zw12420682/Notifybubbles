<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>通知悬浮气泡</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>通知悬浮气泡 · 测试版 0.2.0</string>
			<key>footerText</key>
			<string>适配目标：iPhone 14 / iOS 16.0.3 / Dopamine RootHide。收到新通知后显示气泡；点击任意气泡打开其最新通知，并清除全部气泡。原系统通知仍保留。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用悬浮气泡</string>
			<key>key</key>
			<string>Enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>local.notifybubbles</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>显示位置</string>
			<key>footerText</key>
			<string>三个开关分别生效。锁屏点击仍需系统认证。关闭某个位置只隐藏气泡；关闭总开关会清空气泡。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>锁屏显示</string>
			<key>key</key>
			<string>ShowOnLock</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>local.notifybubbles</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>主屏显示</string>
			<key>key</key>
			<string>ShowOnHome</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>local.notifybubbles</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>App 内显示</string>
			<key>key</key>
			<string>ShowInApps</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>local.notifybubbles</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>图标外观</string>
			<key>footerText</key>
			<string>大小范围 32–80 点，默认 48 点；不透明度范围 20%–100%，越低越透明。修改即时生效。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>图标大小</string>
			<key>key</key>
			<string>IconSize</string>
			<key>defaults</key>
			<string>local.notifybubbles</string>
			<key>default</key>
			<integer>48</integer>
			<key>min</key>
			<integer>32</integer>
			<key>max</key>
			<integer>80</integer>
			<key>showValue</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>图标不透明度</string>
			<key>key</key>
			<string>IconOpacity</string>
			<key>defaults</key>
			<string>local.notifybubbles</string>
			<key>default</key>
			<real>1.0</real>
			<key>min</key>
			<real>0.2</real>
			<key>max</key>
			<real>1.0</real>
			<key>showValue</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>气泡与角标</string>
			<key>footerText</key>
			<string>气泡平时在右侧只露出一半；新通知到达时完整伸出，停留 3 秒后自动缩回。连续通知重新计时。左上角角标与系统桌面图标一致。动画遵循系统“减弱动态效果”。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>清除全部气泡</string>
			<key>action</key>
			<string>clearBubbles</string>
		</dict>
	</array>
</dict>
</plist>
