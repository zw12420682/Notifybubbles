			<string>IconSize</string>
			<key>defaults</key>
			<string>local.notifybubbles</string>
			<key>default</key>
			<integer>48</integer>
			<key>min</key>
			<integer>32</integer>
			<key>max</key>
			<integer>80</integer>
			<key>showValue</key>
			<true/>
