			<string>ClosePreviousSplit</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>local.notifybubbles</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
